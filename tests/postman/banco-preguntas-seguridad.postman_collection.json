  {
   "name": "1. Obtener tokens",
   "item": [
    {
     "name": "Token admin",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('token obtenido', () => pm.response.to.have.status(200));",
         "pm.collectionVariables.set('tokenAdmin', pm.response.json().access_token);"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [],
      "body": {
       "mode": "urlencoded",
       "urlencoded": [
        {
         "key": "grant_type",
         "value": "password"
        },
        {
         "key": "client_id",
         "value": "banco-preguntas-client"
        },
        {
         "key": "username",
         "value": "admin@unicauca.edu.co"
        },
        {
         "key": "password",
         "value": "admin123"
        }
       ]
      },
      "url": "{{keycloak}}/realms/banco-preguntas/protocol/openid-connect/token"
     }
    },
