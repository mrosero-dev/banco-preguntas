{
 "info": {
  "name": "Banco de Preguntas - pruebas de seguridad (ESC-S1)",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Ejecutar la carpeta 1 primero y luego la carpeta 2 con el Collection Runner. Requiere el stack levantado con Docker Compose."
 },
 "variable": [
  {
   "key": "keycloak",
   "value": "http://localhost:8180"
  },
  {
   "key": "question",
   "value": "http://localhost:8080"
  },
  {
   "key": "review",
   "value": "http://localhost:8082"
  },
  {
