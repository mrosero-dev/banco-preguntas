  {
   "name": "2. Accesos que deben ser rechazados",
   "item": [
    {
     "name": "Sin token: listar preguntas",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('responde 401', () => pm.response.to.have.status(401));"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{question}}/api/questions?authorId=2"
     }
    },
    {
     "name": "Token inválido: listar preguntas",
     "event": [
